{
  "name": "milim-nirdafot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:layout": "tsx scripts/build-layout.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "predev": "tsx scripts/build-layout.ts",
    "prebuild": "tsx scripts/build-layout.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "apply:content-changes": "tsx scripts/apply-content-changes.ts",
    "report:near-misses": "tsx scripts/report-near-misses.ts",
    "tts:compare": "tsx scripts/tts-compare.ts",
    "gen:audio": "tsx scripts/gen-audio.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:parents": "tsx scripts/seed-parents.ts",
    "build:emulator": "VITE_FIREBASE_EMULATOR=true vite build --outDir dist-emulator",
    "test:e2e:sync": "firebase emulators:exec --only auth,firestore --project demo-word-quest \"playwright test -c playwright.sync.config.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-word-quest-rules \"vitest run -c vitest.rules.config.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/rubik": "^5.3.0",
    "firebase": "^13.1.0",
    "framer-motion": "^14.6.0",
    "howler": "^2.2.4",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  }
}
