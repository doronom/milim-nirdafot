# Copy to .env and fill in. .env is git-ignored: never commit it.
# Google Cloud Text-to-Speech key, restricted to the Text-to-Speech API. Used only by npm run tts:compare and
# npm run gen:audio on your machine; the app and CI never need it.
GOOGLE_TTS_API_KEY=

# Parent allowlist for cloud sync, comma-separated Google account addresses. Written to Firestore (config/parents) by
# npm run seed:parents; never committed or printed.
PARENT_EMAILS=
